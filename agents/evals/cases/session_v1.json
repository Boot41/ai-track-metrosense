{
  "catalog_id": "session_v1",
  "name": "MetroSense Session V1",
  "description": "Session continuity and retry-path eval cases for MetroSense.",
  "default_session_input": {
    "app_name": "metrosense_agent",
    "user_id": "metrosense-eval-user",
    "state": {}
  },
  "cases": [
    {
      "case_id": "history_readback_001",
      "suite": "session",
      "tier_targets": ["agent_only", "backend_e2e"],
      "conversation": [
        {
          "user_message": "What is the flood risk in Bellandur tonight?",
          "session_action": "new",
          "expectation": {
            "reference_response": "Provide a Bellandur flood-risk summary with a freshness caveat.",
            "must_include": ["bellandur", "flood"],
            "expected_tools": ["resolve_location", "get_weather_current", "get_flood_incidents"]
          }
        },
        {
          "user_message": "What was the main reason you said that?",
          "session_action": "continue",
          "expectation": {
            "reference_response": "Explain the earlier flood-risk answer by referencing rainfall, incidents, or thresholds mentioned in the prior turn.",
            "must_include": ["rain", "incident"],
            "expected_tools": []
          }
        }
      ],
      "backend_assertions": {"expect_history_persisted": true, "expect_same_public_session_id": true},
      "tags": ["session", "continuity", "flood"]
    },
    {
      "case_id": "token_overflow_retry_001",
      "suite": "session",
      "tier_targets": ["backend_e2e"],
      "conversation": [
        {
          "user_message": "Replay the overflow retry fixture.",
          "session_action": "force_overflow_fixture",
          "fixture_name": "backend_overflow_retry_fixture.json",
          "expectation": {
            "reference_response": "Use a fixture to validate the backend retry path when token overflow occurs.",
            "must_include": ["reply after overflow reset"]
          }
        }
      ],
      "backend_assertions": {"expect_retry_session_suffix_used": true, "expect_same_public_session_id": true},
      "tags": ["session", "overflow", "retry"]
    }
  ]
}
